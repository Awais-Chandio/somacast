# Copy to apps/web/.env and fill in from Supabase dashboard -> Project Settings -> API.
# Same project as the phone. Only the public URL and the anon (publishable) key belong here;
# RLS decides what a signed-in flight surgeon can read and write.
# Never put the service-role key or the database password in the web app.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
