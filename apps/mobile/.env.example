# Copy to apps/mobile/.env and fill in from Supabase dashboard -> Project Settings -> API.
# Only the public URL and the anon (publishable) key belong here. RLS protects the data.
# Never put the service-role key or the database password in the app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
