{
  "name": "somacast",
  "private": true,
  "description": "Body weather for crews beyond Earth. NASA Space Apps Challenge 2026 entry.",
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "android": "npm --prefix apps/mobile run android",
    "web": "npm --prefix apps/web run dev",
    "test": "npm run test:core && npm run test:mobile && npm run test:web",
    "test:core": "npm --prefix packages/core test",
    "test:mobile": "npm --prefix apps/mobile test",
    "test:web": "npm --prefix apps/web test",
    "rls-check": "node scripts/rls-check.mjs",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "supabase": "^2.121.0"
  }
}
